# ===========================================
# SMS Enterprise - Git Ignore
# ===========================================

# Environment
.env
.env.local
.env.*.local
!.env.example

# Dependencies
backend/vendor/
backend/node_modules/
frontend/node_modules/
mobile/.dart_tool/
mobile/build/
mobile/.packages
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies

# Laravel
backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/bootstrap/cache/*
!backend/storage/framework/cache/.gitkeep
!backend/storage/framework/sessions/.gitkeep
!backend/storage/framework/views/.gitkeep
!backend/storage/logs/.gitkeep
!backend/bootstrap/cache/.gitkeep

# Build
backend/public/hot
backend/public/storage
backend/public/build
frontend/dist/
frontend/build/

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.phpunit.result.cache
backend/coverage/
frontend/coverage/

# Docker
docker/nginx/ssl/*.pem
docker/nginx/ssl/*.key
docker/nginx/ssl/*.crt

# Temporary
*.tmp
*.temp
*.bak

# Compiled
*.class
*.dll
*.exe
*.o
*.so
