# ===========================================
# Docker Compose Override (Development)
# ===========================================
# Copy this file to docker-compose.override.yml
# for local development customizations
# ===========================================

version: '3.8'

services:
  # Enable Xdebug for PHP
  php:
    build:
      args:
        XDEBUG_ENABLED: 'true'
    environment:
      XDEBUG_MODE: debug
      XDEBUG_CONFIG: client_host=host.docker.internal

  # Map additional ports
  nginx:
    ports:
      - "8080:80"

  # Add adminer for database management
  adminer:
    image: adminer
    container_name: sms_adminer
    restart: unless-stopped
    ports:
      - "8081:8080"
    networks:
      - sms_network
