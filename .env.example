# ===========================================
# SMS Enterprise - Environment Configuration
# ===========================================

# Application
APP_NAME="SMS Enterprise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80
APP_SSL_PORT=443

# Database - PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sms_db
DB_USERNAME=sms_user
DB_PASSWORD=sms_secret

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=sms_redis_secret
REDIS_PORT=6379

# Cache
CACHE_DRIVER=redis
CACHE_PREFIX=sms_cache_

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Queue
QUEUE_CONNECTION=redis

# Mail (Development - Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@sms.local"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DASHBOARD_PORT=8025

# Filesystem
FILESYSTEM_DISK=local

# MinIO (S3 Compatible Storage)
MINIO_ROOT_USER=sms_minio
MINIO_ROOT_PASSWORD=sms_minio_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

AWS_ACCESS_KEY_ID=sms_minio
AWS_SECRET_ACCESS_KEY=sms_minio_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=sms-storage
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Vite (Frontend)
VITE_PORT=5173

# Horizon
HORIZON_PREFIX=sms_horizon_

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8080,localhost:3000,127.0.0.1,127.0.0.1:8080,127.0.0.1:8000,::1

# Multi-Tenant
TENANCY_ENABLED=true
TENANCY_CENTRAL_DOMAINS=admin.sms.local

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=debug

# Timezone
APP_TIMEZONE=Asia/Jakarta
